{
  "name": "spil",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Børnespil til 3. klasse i browseren",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
